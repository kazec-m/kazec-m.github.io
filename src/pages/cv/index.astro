---
import Layout from '../../layouts/Layout.astro';

const entries = [
  { period: '2006', text: '奈良女子大学大学院 人間文化研究科(修士)修了' },
  { period: '2006–2009', text: '大阪大学大学院 実験員 (構造生物・創薬)' },
  { period: '2009-2026', text: '家庭の事情によりフルタイム就労を離れる' },
  { period: '2026', text: 'Ms.Engineer ブートキャンプ修了(経済産業大臣認定Reスキル講座、ITスキル標準レベル4相当のスキル取得)' },
];
---

<Layout title="CV">
  <div class="max-w-2xl mx-auto px-6 md:px-8 lg:px-12 py-14">
    <h1 class="font-mincho text-2xl text-ink mb-8">CV</h1>

    <div class="flex flex-col">
      {entries.map((entry, i) => (
        <div
          class={`flex gap-5 py-3.5 font-gothic ${
            i < entries.length - 1 ? 'border-b border-border' : ''
          }`}
        >
          <span class="text-[13px] text-ink-soft min-w-[92px] shrink-0">{entry.period}</span>
          <span class="text-sm text-ink">{entry.text}</span>
        </div>
      ))}
    </div>

    <p class="font-gothic text-xs text-ink-soft mt-6">
      9年間、小学校での読み聞かせボランティアを継続。
    </p>
  </div>
</Layout>
