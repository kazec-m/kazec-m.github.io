---
import Layout from '../layouts/Layout.astro';

const featuredWork = [
  { title: 'Scanly', href: '/work/#scanly' },
  { title: 'おかんペイ', href: '/work/#okanpay' },
  { title: '子育ての困りごとを、エンジニアリングで解決する', href: '/work/#personal' },
];
---

<Layout title="About">
  <div class="max-w-2xl mx-auto px-6 md:px-8 lg:px-12 py-14">
    <h1 class="font-mincho text-3xl text-ink">Mariko Kazetani</h1>
    <p class="font-mincho text-lg text-ink mt-1.5">Engineering, quietly and clearly.</p>

    
    <p class="font-gothic text-[15px] leading-8 text-ink mt-7 max-w-[30em]">
      要件定義、フロントエンド、バックエンド、データベース設計、デプロイまでチーム開発で行いました（フルリモート）
    </p>

  </div>
</Layout>
