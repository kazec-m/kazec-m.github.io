---
import Layout from '../layouts/Layout.astro';

---

<Layout title="About">
  <div class="max-w-2xl mx-auto px-6 md:px-8 lg:px-12 py-8">   
    <div class="mt-1">
    <img
      src="/profile.jpg"
      alt="Mariko Kazetani"
      width="750"
      height="984"
      class="w-28 h-auto flex-shrink-0 rounded-lg"
    />
    </div>
    
    <div class="mt-8">
     <p class="font-mincho text-sm text-ink">
        [Tools I work with]
     </p>  
      <p class="font-gothic text-sm leading-8 text-ink-soft mt-2">
        TypeScript · React · Next.js<br />
        Python · FastAPI · PostgreSQL <br />
        Docker · Firebase · OpenAI API<br />
      </p>

      <p class="font-mincho text-sm text-ink mt-8">
        [Personal projects]
      </p>

      <p class="font-gothic text-sm leading-8 text-ink-soft mt-2">
        Raspberry Pi · Lua · Bluetooth<br />
      </p>

    </div>
  </div>
</Layout>
