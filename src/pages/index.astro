---
import Layout from '../layouts/Layout.astro';

---

<Layout title="About">
  <div class="max-w-2xl mx-auto px-6 md:px-8 lg:px-12 py-8">
    <p class="font-mincho text-lg text-ink">Engineering, quietly and clearly.</p>
    
    <div class="mt-7">
    <img
      src="/profile.jpg"
      alt="Mariko Kazetani"
      width="750"
      height="984"
      class="w-36 h-auto flex-shrink-0 rounded-lg"
    />
    </div>
    
    <div class="mt-8">
          <p class="font-gothic text-sm text-ink-soft">
            Tools I work with
          </p>  
      <p class="font-tothic text-sm leading-7 text-ink mt-1">
        Python · FastAPI · TypeScript · React<br />
        PostgreSQL · Docker · Git
      </p>
    </div>
  </div>
</Layout>
