---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About">
  <div class="max-w-2xl mx-auto px-6 md:px-8 lg:px-12 py-8">
    <p class="font-mincho text-sm text-ink-soft">
      about me
    </p>

    <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-10 mt-2">
      <img
        src="/profile.jpg"
        alt="Mariko Kazetani"
        width="750"
        height="984"
        class="w-28 aspect-[3/4] object-cover rounded-lg flex-shrink-0
               md:w-auto md:aspect-auto md:h-[20vh]"
      />

      <div>
        <p class="font-mincho text-sm text-ink">[Tools I work with]</p>
        <p class="font-gothic text-sm leading-8 text-ink-soft mt-2">
          TypeScript · Next.js · OpenAI API<br />
          Python · FastAPI · PostgreSQL <br />
        </p>
        <p class="font-mincho text-sm text-ink mt-8">[Personal projects]</p>
        <p class="font-gothic text-sm leading-8 text-ink-soft mt-2">
          Raspberry Pi · Lua · Selenium<span class="hidden sm:inline"> · Bluetooth</span>
          <span class="hidden sm:block">Home network · device access control<br />Astro</span><br />
        </p>
      </div>
    </div>
  </div>
</Layout>